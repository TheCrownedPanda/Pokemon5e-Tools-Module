{
  "id": "pokemon5e-encounters",
  "title": "Pokémon 5e Tools",
  "description": "One-click random encounters for Pokémon 5e, modeled on the poke5e.app encounter tool, with shinies, pinned Pokémon, level scaling and a per-player Pokédex.",
  "version": "0.11.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Pokémon 5e Encounters contributors"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/encounters.css"
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "pokemon5e",
        "type": "module",
        "compatibility": {
          "minimum": "0.13.0"
        }
      }
    ]
  },
  "license": "LICENSE"
}