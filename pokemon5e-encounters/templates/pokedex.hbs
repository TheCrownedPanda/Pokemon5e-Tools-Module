<div class="pk5e-dex">
	<header class="pk5e-dex-head">
		<div class="pk5e-dex-count">Seen <strong>{{seenCount}}</strong> · Caught <strong>{{caughtCount}}</strong> <span class="pk5e-hint">of {{total}}</span></div>
		{{#if isGM}}
		<label class="pk5e-dex-view">Viewing
			<select id="pk5e-dex-view">{{#each viewOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
		</label>
		{{/if}}
		{{#unless isGM}}<button type="button" data-action="refresh" data-tooltip="Scan the field again"><i class="fa-solid fa-satellite-dish"></i> Scan</button>{{else}}<button type="button" data-action="refresh" data-tooltip="Refresh"><i class="fa-solid fa-rotate"></i></button>{{/unless}}
		{{#if isGM}}<button type="button" data-action="scanFor" data-scope="one" data-tooltip="Register every unhidden Pokémon on this scene as seen for the player being viewed"><i class="fa-solid fa-satellite-dish"></i> Scan for player</button>
		<button type="button" data-action="registerOwned" data-scope="one" data-tooltip="Mark the viewed player's owned Pokémon as caught"><i class="fa-solid fa-circle-check"></i> Register owned</button>
		<button type="button" data-action="registerOwned" data-scope="all" data-tooltip="Mark owned Pokémon as caught for every player"><i class="fa-solid fa-users"></i> Owned: all</button>{{/if}}
		{{#if canClear}}<button type="button" class="pk5e-danger" data-action="clear" data-tooltip="Erase this player's Pokédex"><i class="fa-solid fa-eraser"></i> Clear</button>{{/if}}
		{{#if isGM}}<button type="button" class="pk5e-danger" data-action="clearAll" data-tooltip="Erase every player's Pokédex"><i class="fa-solid fa-eraser"></i> Clear All</button>{{/if}}
	</header>

	{{#if banner.length}}
	<div class="pk5e-banner">
		{{#each banner}}<div><i class="fa-solid fa-circle-plus"></i> NEW ENTRY {{number}} <strong>{{name}}</strong>{{#if shiny}} ✨ Shiny!{{/if}} registered</div>{{/each}}
	</div>
	{{/if}}

	{{#if showField}}
	<section class="pk5e-field">
		<h3><i class="fa-solid fa-satellite-dish"></i> Scanner</h3>
		{{#if field.length}}
		<ul class="pk5e-field-list">
			{{#each field}}
			<li>
				<img src="{{img}}" alt="">
				<span class="pk5e-field-name">{{name}}{{#if shiny}} ✨{{/if}}{{#if count}} <span class="pk5e-hint">×{{count}}</span>{{/if}}</span>
				{{#if isNew}}<span class="pk5e-new">NEW</span>{{else}}<span class="pk5e-registered"><i class="fa-solid fa-check"></i> Registered</span>{{/if}}
				<button type="button" data-action="select" data-species="{{id}}">View</button>
			</li>
			{{/each}}
		</ul>
		{{else}}
		<p class="pk5e-hint">Nothing to scan. Open your Pokédex while a Pokémon is in view to register it.</p>
		{{/if}}
	</section>
	{{/if}}

	<div class="pk5e-dex-body">
		<section class="pk5e-dex-list">
			<div class="pk5e-dex-filters">
				<input type="search" id="pk5e-dex-search" placeholder="Search..." value="{{search}}" autocomplete="off">
				<select id="pk5e-dex-status">{{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
			</div>
			<div class="pk5e-dex-grid">
				{{#each tiles}}
				<button type="button" class="pk5e-tile {{status}} {{#if selected}}selected{{/if}}" data-action="select" data-species="{{id}}" data-name="{{filterName}}" data-status="{{status}}">
					<span class="pk5e-tile-num">{{number}}</span>
					{{#if sprite}}<img src="{{sprite}}" alt="{{label}}" loading="lazy">{{else}}<span class="pk5e-tile-unknown">?</span>{{/if}}
					<span class="pk5e-tile-name">{{label}}{{#if shiny}} ✨{{/if}}</span>
					{{#if known}}<i class="pk5e-tile-mark fa-solid {{#if caughtMark}}fa-circle-check{{else}}fa-eye{{/if}}"></i>{{/if}}
				</button>
				{{/each}}
			</div>
		</section>

		<section class="pk5e-dex-detail">
			{{#if detail}}
			<div class="pk5e-detail-head">
				<h2>{{detail.number}} {{detail.name}}{{#if detail.shiny}} ✨{{/if}}</h2>
				<span class="pk5e-status {{detail.status}}">{{detail.statusLabel}}</span>
			</div>
			{{#if detail.locked}}
			<div class="pk5e-detail-unknown">?</div>
			<p class="pk5e-hint">Nothing is known about this Pokémon yet. It is registered when its Pokédex is opened while one is in view.</p>
			{{else}}
			{{#if detail.img}}<img class="pk5e-portrait" src="{{detail.img}}" alt="{{detail.name}}">{{/if}}
			{{#if detail.credit}}<p class="pk5e-hint">Art by {{#if detail.credit.link}}<a href="{{detail.credit.link}}" target="_blank" rel="noopener">{{detail.credit.author}}</a>{{else}}{{detail.credit.author}}{{/if}}</p>{{/if}}
			{{#if detail.fakemon}}<p class="pk5e-hint">Fakemon (not an official Pokémon).</p>{{/if}}
			<div class="pk5e-types">{{#each detail.types}}<span class="pk5e-type">{{this}}</span>{{/each}}</div>
			<p class="pk5e-flavor">{{detail.desc}}</p>
			<p class="pk5e-habitat">{{detail.habitat}}</p>
			{{#if detail.isUnseen}}<p class="pk5e-hint">Reference view: this Pokémon has not been seen yet.</p>{{/if}}
			{{#if detail.full}}
			{{#if detail.fullIsPreview}}<p class="pk5e-hint">Reference view: players see this full entry once they catch it.</p>{{/if}}
			{{#with detail.full}}
			<h3>Overview</h3>
			<ul class="pk5e-facts">
				<li><strong>Size</strong> {{size}}</li><li><strong>SR</strong> {{sr}}</li><li><strong>Min level</strong> {{minLevel}}</li>
				<li><strong>AC</strong> {{ac}}</li><li><strong>Hit points</strong> {{hp}}</li><li><strong>Speed</strong> {{speeds}}</li>
			</ul>
			<table class="pk5e-scores"><tr>{{#each scores}}<th>{{key}}</th>{{/each}}</tr><tr>{{#each scores}}<td>{{value}} ({{mod}})</td>{{/each}}</tr></table>
			<ul class="pk5e-facts">
				<li><strong>Skills</strong> {{skills}}</li><li><strong>Saving throws</strong> {{saves}}</li><li><strong>Senses</strong> {{senses}}</li>
			</ul>
			<h3>Abilities</h3>
			<ul class="pk5e-abilities">{{#each abilities}}<li><strong>{{name}}</strong>{{#if hidden}} <em>(hidden)</em>{{/if}}: {{description}}</li>{{/each}}</ul>
			<h3>Moves</h3>
			<ul class="pk5e-moves">{{#each moveGroups}}<li><strong>{{label}}:</strong> {{#each names}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</li>{{/each}}</ul>
			<h3>Breeding and range</h3>
			<ul class="pk5e-facts">
				<li><strong>Egg groups</strong> {{eggGroups}}</li><li><strong>Gender ratio</strong> {{gender}}</li>
				<li><strong>Native to</strong> {{native}}</li><li><strong>Found in</strong> {{regions}}</li>
			</ul>
			{{#if evolvesFrom.length}}<p><strong>Evolves from:</strong> {{#each evolvesFrom}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
			{{#if evolvesInto.length}}<p><strong>Evolves into:</strong> {{#each evolvesInto}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
			{{/with}}
			{{/if}}
			{{/if}}
			{{#if isGM}}
			<div class="pk5e-gm-tools">
				<span>Set status{{#if viewingOther}} for this player{{/if}}:</span>
				<button type="button" data-action="setStatus" data-species="{{detail.id}}" data-status="unseen">Not seen</button>
				<button type="button" data-action="setStatus" data-species="{{detail.id}}" data-status="seen">Seen</button>
				<button type="button" data-action="setStatus" data-species="{{detail.id}}" data-status="caught">Caught</button>
			</div>
			{{/if}}
			{{else}}
			<p class="pk5e-hint">Select an entry to read about it.</p>
			{{/if}}
		</section>
	</div>
</div>
